  {
    "type": "effect_on_condition",
    "id": "EOC_DW_DAMAGE_BASH_SECONDARY",
    "eoc_type": "ACTIVATION",
    "condition": { "and": [ "npc_is_character", { "math": [ "_damage_taken > 0" ] } ] },
    "effect": [
      {
        "if": {
          "compare_string": [
            { "context_val": "bp" },
            "arm_l",
            "arm_r",
            "hand_l",
            "hand_r",
            "leg_l",
            "leg_r",
            "foot_l",
            "foot_r"
          ]
        },
        "then": {
          "run_eocs": [
            "EOC_DW_STRUCTURAL_LIMB_BASH_MINOR",
            "EOC_DW_STRUCTURAL_LIMB_BASH_MODERATE",
            "EOC_DW_STRUCTURAL_LIMB_BASH_SEVERE",
            "EOC_DW_STRUCTURAL_LIMB_BASH_EXTREME"
          ],
          "alpha_talker": "npc",
          "beta_talker": "u"
        }
      },
      {
        "if": { "compare_string": [ { "context_val": "bp" }, "torso" ] },
        "then": {
          "run_eocs": [
            "EOC_DW_STRUCTURAL_TORSO_BASH_MODERATE",
            "EOC_DW_STRUCTURAL_TORSO_BASH_SEVERE",
            "EOC_DW_STRUCTURAL_TORSO_BASH_EXTREME"
          ],
          "alpha_talker": "npc",
          "beta_talker": "u"
        }
      }
    ],
    "//": "ondamage_eocs uses u=source and npc=damaged target. The talker swap makes the damaged character u for the existing outcome EOCs."
  },
