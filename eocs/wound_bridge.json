[
  {
    "type": "effect_on_condition",
    "id": "EOC_DW_BRIDGE_ON_WOUND_CREATED",
    "eoc_type": "ACTIVATION",
    "//": "Primary entry point for the future engine hook. Expected variables: bp = affected bodypart, wound_id = newly created wound.",
    "condition": {
      "expects_vars": [ "bp", "wound_id" ]
    },
    "effect": [
      {
        "run_eocs": "EOC_DW_BRIDGE_ROUTE_PRIMARY_WOUND",
        "variables": {
          "bp": { "context_val": "bp" },
          "wound_id": { "context_val": "wound_id" }
        }
      }
    ]
  },

  {
    "type": "effect_on_condition",
    "id": "EOC_DW_BRIDGE_ROUTE_PRIMARY_WOUND",
    "eoc_type": "ACTIVATION",
    "//": "Routes newly created primary wounds into the appropriate complication system.",
    "condition": {
      "expects_vars": [ "bp", "wound_id" ]
    },
    "effect": [
      {
        "if": {
          "compare_string": [
            { "context_val": "wound_id" },
            "dw_scratch",
            "dw_shallow_cut",
            "dw_minor_puncture",
            "dw_puncture_wound",
            "dw_ballistic_graze",
            "dw_split_lip"
          ]
        },
        "then": {
          "run_eocs": "EOC_DW_ROLL_MINOR_OPEN_WOUND_COMPLICATION",
          "variables": {
            "bp": { "context_val": "bp" }
          }
        }
      },

      {
        "if": {
          "compare_string": [
            { "context_val": "wound_id" },
            "dw_laceration",
            "dw_deep_laceration",
            "dw_deep_puncture",
            "dw_penetrating_wound",
            "dw_oral_laceration",
            "dw_deep_facial_laceration",
            "dw_ocular_laceration"
          ]
        },
        "then": {
          "run_eocs": "EOC_DW_ROLL_DEEP_OPEN_WOUND_COMPLICATION",
          "variables": {
            "bp": { "context_val": "bp" }
          }
        }
      },

      {
        "if": {
          "compare_string": [
            { "context_val": "wound_id" },
            "dw_severe_laceration",
            "dw_avulsion_wound",
            "dw_severe_penetrating_wound",
            "dw_devastating_penetrating_wound",
            "dw_open_fracture",
            "dw_penetrating_ocular_injury"
          ]
        },
        "then": {
          "run_eocs": "EOC_DW_ROLL_SEVERE_OPEN_WOUND_COMPLICATION",
          "variables": {
            "bp": { "context_val": "bp" }
          }
        }
      },

      {
        "if": {
          "compare_string": [
            { "context_val": "wound_id" },
            "dw_superficial_gunshot_wound",
            "dw_penetrating_gunshot_wound",
            "dw_severe_gunshot_wound"
          ]
        },
        "then": {
          "run_eocs": "EOC_DW_ROLL_GUNSHOT_COMPLICATION",
          "variables": {
            "bp": { "context_val": "bp" }
          }
        }
      },

      {
        "if": {
          "compare_string": [
            { "context_val": "wound_id" },
            "dw_devastating_ballistic_wound"
          ]
        },
        "then": {
          "run_eocs": "EOC_DW_ROLL_DEVASTATING_GUNSHOT_COMPLICATION",
          "variables": {
            "bp": { "context_val": "bp" }
          }
        }
      },

      {
        "if": {
          "compare_string": [
            { "context_val": "wound_id" },
            "dw_deep_partial_thickness_burn",
            "dw_full_thickness_burn",
            "dw_extensive_full_thickness_burn",
            "dw_deep_chemical_burn",
            "dw_full_thickness_chemical_burn",
            "dw_extensive_chemical_burn",
            "dw_deep_electrical_burn",
            "dw_severe_electrical_tissue_injury",
            "dw_extensive_electrical_tissue_destruction"
          ]
        },
        "then": {
          "run_eocs": "EOC_DW_ROLL_MAJOR_BURN_COMPLICATION",
          "variables": {
            "bp": { "context_val": "bp" }
          }
        }
      }
    ]
  },

  {
    "type": "effect_on_condition",
    "id": "EOC_DW_BRIDGE_ON_WOUND_TREATED",
    "eoc_type": "ACTIVATION",
    "//": "Primary entry point for the future wound_fix engine hook. Expected variables are the bodypart, removed wound and newly created treated wound.",
    "condition": {
      "expects_vars": [ "bp", "old_wound_id", "new_wound_id" ]
    },
    "effect": [
      {
        "run_eocs": "EOC_DW_BRIDGE_ROUTE_TREATMENT",
        "variables": {
          "bp": { "context_val": "bp" },
          "old_wound_id": { "context_val": "old_wound_id" },
          "new_wound_id": { "context_val": "new_wound_id" }
        }
      }
    ]
  },

  {
    "type": "effect_on_condition",
    "id": "EOC_DW_BRIDGE_ROUTE_TREATMENT",
    "eoc_type": "ACTIVATION",
    "//": "Routes treated wound states into cleanup actions. Infection deliberately remains separate from contamination.",
    "condition": {
      "expects_vars": [ "bp", "old_wound_id", "new_wound_id" ]
    },
    "effect": [
      {
        "if": {
          "compare_string": [
            { "context_val": "new_wound_id" },

            "dw_dressed_scratch",
            "dw_dressed_shallow_cut",

            "dw_cleaned_laceration",
            "dw_cleaned_deep_laceration",
            "dw_cleaned_severe_laceration",

            "dw_cleaned_minor_puncture",
            "dw_cleaned_puncture_wound",
            "dw_cleaned_deep_puncture",
            "dw_cleaned_penetrating_wound",

            "dw_dressed_ballistic_graze",
            "dw_cleaned_superficial_gunshot_wound",
            "dw_cleaned_penetrating_gunshot_wound",

            "dw_irrigated_cornea_abrasion",
            "dw_dressed_split_lip",
            "dw_cleaned_oral_laceration",
            "dw_cleaned_deep_facial_laceration",

            "dw_stabilized_open_fracture"
          ]
        },
        "then": {
          "run_eocs": "EOC_DW_BRIDGE_CLEAR_CONTAMINATION",
          "variables": {
            "bp": { "context_val": "bp" }
          }
        }
      },

      {
        "if": {
          "compare_string": [
            { "context_val": "new_wound_id" },

            "dw_debrided_avulsion_wound",
            "dw_debrided_severe_gunshot_wound",
            "dw_debrided_full_thickness_burn"
          ]
        },
        "then": {
          "run_eocs": "EOC_DW_BRIDGE_DEBRIDEMENT_CLEANUP",
          "variables": {
            "bp": { "context_val": "bp" }
          }
        }
      }
    ]
  },

  {
    "type": "effect_on_condition",
    "id": "EOC_DW_BRIDGE_CLEAR_CONTAMINATION",
    "eoc_type": "ACTIVATION",
    "//": "Successful wound cleaning removes Detailed Wounds contamination from the treated bodypart. Existing infection is deliberately not removed.",
    "condition": {
      "expects_vars": [ "bp" ]
    },
    "effect": [
      {
        "u_lose_effect": "dw_wound_contamination",
        "target_part": { "context_val": "bp" }
      }
    ]
  },

  {
    "type": "effect_on_condition",
    "id": "EOC_DW_BRIDGE_DEBRIDEMENT_CLEANUP",
    "eoc_type": "ACTIVATION",
    "//": "Debridement removes contamination and already necrotic local tissue. Established infection remains and requires separate treatment.",
    "condition": {
      "expects_vars": [ "bp" ]
    },
    "effect": [
      {
        "u_lose_effect": "dw_wound_contamination",
        "target_part": { "context_val": "bp" }
      },
      {
        "u_lose_effect": "dw_tissue_necrosis",
        "target_part": { "context_val": "bp" }
      }
    ]
  }
]